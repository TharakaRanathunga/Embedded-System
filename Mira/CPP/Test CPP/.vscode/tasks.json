{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++ Build & Run",
            "type": "shell",
            "command": "g++ \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" -mconsole && \"${fileDirname}\\${fileBasenameNoExtension}.exe\"",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}


